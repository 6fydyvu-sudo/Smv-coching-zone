# ---------------------------------------------------------------------------
# S.M.V Coaching Zone — Environment Variables
# Copy this file to .env (development) or configure these in your hosting
# provider's dashboard (production). NEVER commit the real .env file.
# ---------------------------------------------------------------------------

# PostgreSQL connection string
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE?schema=public
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/smv_coaching_zone?schema=public"

# NextAuth
# Generate a strong secret with: openssl rand -base64 32
NEXTAUTH_SECRET="replace-with-a-long-random-string"
NEXTAUTH_URL="http://localhost:3000"

# Public app URL (used for absolute links, SEO, sitemap generation)
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# File uploads
# In this version, files are stored on local disk under /public/uploads.
# For production behind a read-only filesystem (e.g. Vercel), swap the
# storage adapter in src/lib/storage.ts for S3/Cloudinary/etc and set the
# credentials below.
UPLOAD_MAX_SIZE_MB=10
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=
# S3_BUCKET=
# S3_REGION=
# S3_ENDPOINT=

# Payment gateways (NOT integrated in this version — placeholders only).
# Do not fill these in expecting live payments to work; see README.
# BKASH_APP_KEY=
# BKASH_APP_SECRET=
# BKASH_USERNAME=
# BKASH_PASSWORD=
# NAGAD_MERCHANT_ID=
# NAGAD_MERCHANT_PRIVATE_KEY=

# Email/SMS (NOT integrated in this version — placeholders only).
# SMTP_HOST=
# SMTP_PORT=
# SMTP_USER=
# SMTP_PASSWORD=
# SMS_API_KEY=
